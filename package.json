{
  "name": "ganhammar",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "API_TOKEN=${API_TOKEN:-$(gh auth token)} vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "test:e2e": "node e2e/run.mjs",
    "test:smoke": "node e2e/smoke.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "cdk": "cdk",
    "deploy": "cdk deploy --require-approval never --app 'npx tsx infra/bin/app.ts'",
    "preview:static": "node e2e/serve.mjs"
  },
  "dependencies": {
    "hast-util-to-html": "^9.0.5",
    "lowlight": "^3.3.0",
    "marked": "^18.0.9",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "aws-cdk": "^2.1136.0",
    "aws-cdk-lib": "^2.265.0",
    "constructs": "^10.8.1",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
